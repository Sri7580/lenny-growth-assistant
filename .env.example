# --- Database ---
POSTGRES_USER=lenny
POSTGRES_PASSWORD=lenny_dev_pw
POSTGRES_DB=lenny_growth_assistant
DATABASE_URL=postgresql+asyncpg://lenny:lenny_dev_pw@db:5432/lenny_growth_assistant

# --- LLM Provider Toggle ---
# Options: "ollama" or "anthropic"
DEFAULT_LLM_PROVIDER=ollama

# --- Ollama (local model, required for demo) ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b

# --- Anthropic (cloud provider) ---
# Required only if DEFAULT_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- App ---
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
